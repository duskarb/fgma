#!/bin/zsh

export PATH="/Users/namkyuyeo/.npm-global/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

PROJECT_DIR="/Users/namkyuyeo/Documents/poster generator"
PORT="3000"
URL="http://localhost:${PORT}"
LOG_FILE="/tmp/poster-generator.log"

# 이미 실행 중이면 바로 열기
if lsof -nP -iTCP:${PORT} -sTCP:LISTEN >/dev/null 2>&1; then
  open "${URL}"
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  osascript -e 'display dialog "npm을 찾을 수 없습니다. Node.js가 설치되어 있는지 확인해주세요." buttons {"확인"} default button "확인" with icon caution'
  exit 1
fi

# 백그라운드로 서버 시작
cd "${PROJECT_DIR}"
nohup npm run dev > "${LOG_FILE}" 2>&1 &
SERVER_PID=$!

# 최대 30초 대기 (포트가 열릴 때까지)
MAX_WAIT=30
WAITED=0
while ! lsof -nP -iTCP:${PORT} -sTCP:LISTEN >/dev/null 2>&1; do
  sleep 1
  WAITED=$((WAITED + 1))
  if [ $WAITED -ge $MAX_WAIT ]; then
    osascript -e 'display dialog "서버 시작에 실패했습니다.\n로그: /tmp/poster-generator.log" buttons {"확인"} default button "확인" with icon caution'
    exit 1
  fi
done

open "${URL}"
